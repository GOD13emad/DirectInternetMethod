* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.iss text eol=crlf
README.md text eol=lf
linux/**/*.md text eol=lf
linux/**/*.txt text eol=lf
linux/**/*.svg text eol=lf
SHA256SUMS.txt text eol=lf
delivery/SHA256SUMS.txt text eol=lf
# Windows hash-pinned zapret text payloads: preserve published byte identities deterministically.
windows/bin/zapret/hosts.txt text eol=crlf
windows/bin/zapret/adult-fallback-hosts.txt text eol=lf
windows/bin/zapret/strong-override-hosts.txt text eol=crlf
# Exact upstream legal notices: retain original LF bytes across Windows/Linux checkout.
windows/bin/zapret/LICENSE.WinDivert.txt text eol=lf whitespace=-blank-at-eof
windows/bin/zapret/LICENSE.Cygwin.txt text eol=lf whitespace=-blank-at-eol,-blank-at-eof
windows/bin/zapret/LGPL3.Cygwin.txt text eol=lf
windows/bin/zapret/GPL3.Cygwin.txt text eol=lf
