* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.iss text eol=crlf
README.md text eol=lf
linux/**/*.md text eol=lf
linux/**/*.txt text eol=lf
linux/**/*.svg text eol=lf
SHA256SUMS.txt text eol=lf
delivery/SHA256SUMS.txt text eol=lf
# Windows hash-pinned zapret text payloads: preserve published byte identities deterministically.
windows/bin/zapret/hosts.txt text eol=crlf
windows/bin/zapret/adult-fallback-hosts.txt text eol=lf
windows/bin/zapret/strong-override-hosts.txt text eol=crlf
# Exact upstream legal notices: retain original LF bytes across Windows/Linux checkout.
windows/bin/zapret/LICENSE.WinDivert.txt text eol=lf whitespace=-blank-at-eof
windows/bin/zapret/LICENSE.Cygwin.txt text eol=lf whitespace=-blank-at-eol,-blank-at-eof
windows/bin/zapret/LGPL3.Cygwin.txt text eol=lf
windows/bin/zapret/GPL3.Cygwin.txt text eol=lf
# The tracked Inno .iss uses original mixed EOL. Preserve exact bytes on Windows checkout.
windows/installer/DirectInternetMethod.iss -text whitespace=cr-at-eol
# Keep exact OS guest error/receipt bytes; no CRLF normalization.
evidence/DIM_R933_WINDOWS_QT_IFW_* -text whitespace=cr-at-eol
# Preserve byte-exact real Windows guest policy/ledger and failure logs.
evidence/DIM_R934_WINDOWS_BROKER_* -text whitespace=cr-at-eol
# Exact byte fidelity for independently pinned Windows SYSTEM guest receipts.
evidence/DIM_R935_WINDOWS_PIPE_* -text whitespace=cr-at-eol
# Preserve original guest NTFS/System test receipt and denial bytes verbatim.
evidence/DIM_R937_WINDOWS_SCM_* -text whitespace=cr-at-eol
