<Window x:Class="DirectInternetMethod.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Direct Internet Method" Width="980" Height="620" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#0B1624" Foreground="#F7FAFC" Icon="/DirectInternetMethod.ico">
<Window.Resources><SolidColorBrush x:Key="Card" Color="#14263A"/><SolidColorBrush x:Key="Muted" Color="#9FB1C3"/><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style></Window.Resources>
<Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Width="84" Height="84" CornerRadius="20" Background="#102D45" VerticalAlignment="Center">
<Viewbox Width="72" Height="72">
<Canvas Width="512" Height="512">
<Path Fill="White" Data="M103,263 C155,243 199,217 235,183 C233,213 241,237 259,256 C284,230 313,207 348,188 C337,215 321,240 298,263 C336,252 373,249 409,253 C367,271 330,293 298,320 C267,345 236,359 203,360 C155,362 115,329 103,263 Z"/>
<Path Fill="White" Data="M195,210 C186,172 191,136 209,104 C216,138 233,166 260,188 C254,199 245,210 233,220 C219,231 207,233 195,210 Z"/>
<Path Stroke="#23B26B" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M106,317 C179,352 250,354 317,323"/>
<Path Stroke="White" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M124,340 C190,367 255,368 318,343"/>
<Path Stroke="#D93B3B" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M145,362 C201,380 257,380 312,361"/>
</Canvas>
</Viewbox>
</Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"><TextBlock Text="Direct Internet Method" FontSize="30" FontWeight="Bold"/><TextBlock Text="زن زندگی آزادی" HorizontalAlignment="Left" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Direct DNS + DPI bypass — without VPN, proxy, or default-route tunnel" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
<Border Grid.Column="2" Background="#153729" CornerRadius="14" Padding="14,8" VerticalAlignment="Center"><TextBlock x:Name="StatusBadge" Text="OFF" Foreground="#68E8A6" FontSize="15" FontWeight="Bold"/></Border></Grid>
<Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="18" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Physical interface" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="InterfaceText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="IpText" Text="—" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="Adapter DNS" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="DnsText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Physical adapter DNS is not modified" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Owned resources" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="OwnedText" Text="ULA 0 · NRPT 0 · DPI 0" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="RouteText" Text="Broad tunnel routes: 0" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
</Grid></Border>
<Border Grid.Row="4" Background="{StaticResource Card}" CornerRadius="18" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Live checks" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HealthText" Grid.Column="1" Text="Ready" Foreground="{StaticResource Muted}"/></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#0E1D2D" CornerRadius="14" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="YouTube" FontWeight="SemiBold"/><TextBlock x:Name="YoutubeText" Text="—" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="#0E1D2D" CornerRadius="14" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="OpenAI" FontWeight="SemiBold"/><TextBlock x:Name="OpenAiText" Text="—" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Background="#0E1D2D" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="GitHub" FontWeight="SemiBold"/><TextBlock x:Name="GithubText" Text="—" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
</Grid></Grid></Border>
<Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal">
<Button x:Name="StartButton" Content="Start" Background="#2FD07B" Foreground="#06160E" BorderThickness="0" Click="Start_Click"/><Button x:Name="StopButton" Content="Stop" Background="#243C52" Foreground="White" BorderThickness="0" Click="Stop_Click"/><Button x:Name="RefreshButton" Content="Refresh" Background="#243C52" Foreground="White" BorderThickness="0" Click="Refresh_Click"/><Button x:Name="RecoveryButton" Content="Recovery" Background="#5A2630" Foreground="#FFD9DE" BorderThickness="0" Click="Recovery_Click"/><Button x:Name="UpdateButton" Content="Check Direct Update" Background="#314A64" Foreground="White" BorderThickness="0" Click="Update_Click"/></StackPanel>
<TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="Start / Stop / Recovery / direct updates require no UAC after initial install"/></Grid>
</Grid></Window>